# Copy this file to a private path, e.g. ~/.dsh/secrets/mail.env, then chmod 600.
# mail.py never prints or passes these values on the command line.
MAIL_ADDRESS=agent@example.com
MAIL_AUTHCODE=replace-with-your-app-password
IMAP_HOST=imap.example.com
IMAP_PORT=993
SMTP_HOST=smtp.example.com
SMTP_PORT=465

# Optional: explicit CA bundle for Python installations without system certs.
# SSL_CERT_FILE=/etc/ssl/cert.pem
