{
  "watches": [
    {
      "id": "mailbox-account-1",
      "preset": "mailbox",
      "enabled": false,
      "mailbox": {
        "envFile": "/absolute/path/to/mail.env",
        "stateDir": "/absolute/path/to/.dsh/mailbox",
        "allowAccountFile": "/absolute/path/to/allow-accounts.json",
        "remindAfterMinutes": 30,
        "maxNotify": 20,
        "folder": "INBOX",
        "python": "python3"
      },
      "interval": 60,
      "timeout": 60
    }
  ]
}
