{
  "name": "dsh-watch-kit-plugin",
  "version": "0.2.6",
  "description": "Minimal SQLite-backed watch scheduler for DeepSeek Harness: polls checkers and wakes the bound session only when a checker returns a notify event.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "watch",
    "watcher",
    "polling",
    "sqlite"
  ],
  "license": "MIT",
  "author": "rokyaria",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokyaria/dsh-watch-kit-plugin.git"
  },
  "homepage": "https://github.com/rokyaria/dsh-watch-kit-plugin#readme",
  "bugs": {
    "url": "https://github.com/rokyaria/dsh-watch-kit-plugin/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": "^0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "extension",
    "skills"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:mailbox": "python3 -m unittest discover -s test/python -v"
  }
}
