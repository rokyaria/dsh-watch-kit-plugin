{
  "name": "dsh-watch-kit-plugin",
  "version": "0.1.0",
  "description": "Event-driven watch plugin for DeepSeek Harness. Runs user/agent-authored checks on an interval and wakes the bound session only when a check reports an event.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "watch",
    "watcher",
    "polling",
    "event-driven",
    "agent-automation"
  ],
  "license": "MIT",
  "author": "rokyaria",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokyaria/dsh-watch-kit-plugin.git"
  },
  "homepage": "https://github.com/rokyaria/dsh-watch-kit-plugin#readme",
  "bugs": {
    "url": "https://github.com/rokyaria/dsh-watch-kit-plugin/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "files": [
    "lib",
    "skills",
    "assets",
    "examples",
    "test",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
